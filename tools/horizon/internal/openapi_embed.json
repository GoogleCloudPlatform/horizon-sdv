      "get": {
        "description": "Read-only; Git is the only writer.",
        "operationId": "getMirrorConfig",
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "Created"
          },
          "202": {
            "description": "Accepted (run requested; see requestId / runId)"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden (admin role, or volume destroy not allowed in Git)"
          },
          "404": {
            "description": "Not found, or the storage-mirror module is not enabled"
          },
          "409": {
            "description": "Conflict (directory in use, run active, mirrors still exist)"
          },
          "422": {
            "description": "Validation failed (immutable field, bad kind)"
          },
          "502": {
            "description": "storage-mirror module error"
          },
          "503": {
            "description": "storage-mirror module URL, token or CA not configured"
          }
        },
        "summary": "Effective StorageMirrorConfig",
        "tags": [
          "Storage Mirror"
        ]
      }
    },
