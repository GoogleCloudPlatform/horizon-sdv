        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 50, "maximum": 500 }
          },
          {
            "name": "continue",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "phase",
            "in": "query",
