// Description:
// This pipeline builds the ABFS builder Docker image using BuildKit.
// Optional Ubuntu and/or COS-tagged templates in one run.
//
// References:
//   * https://github.com/moby/buildkit
//   * Image: https://hub.docker.com/r/moby/buildkit
//     e.g. image: moby/buildkit:v0.24.0
pipeline {

  // Parameters defined in groovy/job.groovy

  agent none

  environment {
    REGISTRY="${env.CLOUD_REGION}-docker.pkg.dev"
    DESTINATION="${REGISTRY}/${env.CLOUD_PROJECT}/${env.ABFS_BUILD_DOCKER_ARTIFACT_PATH_NAME}"
    PUSH="${NO_PUSH == "true" ? "false" : "true"}"

    def kubernetesPodTemplate = """
      apiVersion: v1
      kind: Pod
      spec:
        hostname: jenkins-aaos-abfs-build-pod
        serviceAccountName: ${JENKINS_SERVICE_ACCOUNT}
        containers:
        - name: buildkit
          image: moby/buildkit:${BUILDKIT_RELEASE_TAG}
          imagePullPolicy: Always
          securityContext:
            privileged: true
          resources:
            limits:
              memory: 4Gi
            requests:
              memory: 4Gi
      """.stripIndent()
  }

  stages {
    stage ('Start instance'){
      agent { kubernetes { yaml kubernetesPodTemplate } }
      stages {
        stage ('Validate template selection'){
          steps {
            script {
              if (env.ENABLE_UBUNTU_TEMPLATE != 'true' && env.ENABLE_COS_TEMPLATE != 'true') {
                error('Enable at least one of ENABLE_UBUNTU_TEMPLATE or ENABLE_COS_TEMPLATE.')
              }
              currentBuild.description =
                "NO_PUSH=${env.NO_PUSH}" + "<br>" +
                "UBUNTU=${env.ENABLE_UBUNTU_TEMPLATE}/${env.IMAGE_TAG_UBUNTU}" + "<br>" +
                "COS=${env.ENABLE_COS_TEMPLATE}/${env.IMAGE_TAG_COS}" + "<br>" +
                "ABFS_REPOSITORY=${env.ABFS_REPOSITORY}" + "<br>" +
                "ABFS_VERSION=${env.ABFS_VERSION}" + "<br>" +
                "ABFS_COS_IMAGE_REF=${env.ABFS_COS_IMAGE_REF}" + "<br>" +
                "$BUILD_USER"
            }
          }
        }

        stage ('Docker Credentials'){
          steps {
            container(name: 'buildkit') {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                sh '''
                  wget -nv -O docker-credential-gcr.tgz ${DOCKER_CREDENTIALS_URL}
                  tar -zxf docker-credential-gcr.tgz
                  chmod +x docker-credential-gcr && mv docker-credential-gcr /usr/bin/
                  rm -f docker-credential-gcr*.tar.gz
                  docker-credential-gcr configure-docker --registries=${REGISTRY}
                '''
              }
            }
          }
        }

        stage ('Build Ubuntu template'){
          when { expression { env.ENABLE_UBUNTU_TEMPLATE == 'true' } }
          steps {
            container(name: 'buildkit') {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                sh '''
                  set -euo pipefail
                  export TEMPLATE_FLAVOR=ubuntu
                  export EFFECTIVE_IMAGE_TAG="${IMAGE_TAG_UBUNTU}"
                  export EFFECTIVE_LINUX_DISTRIBUTION="${LINUX_DISTRIBUTION}"
                  ./workloads/android/pipelines/environment/abfs/docker_image_template/build_abfs_image.sh
                '''
              }
            }
          }
        }

        stage ('Build COS template'){
          when { expression { env.ENABLE_COS_TEMPLATE == 'true' } }
          steps {
            container(name: 'buildkit') {
              catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                sh '''
                  set -euo pipefail
                  export TEMPLATE_FLAVOR=cos
                  export EFFECTIVE_IMAGE_TAG="${IMAGE_TAG_COS}"
                  export EFFECTIVE_LINUX_DISTRIBUTION="${COS_LINUX_DISTRIBUTION}"
                  echo "ABFS_COS_IMAGE_REF (Seed GCE COS node family, not Docker FROM)=${ABFS_COS_IMAGE_REF:-}"
                  ./workloads/android/pipelines/environment/abfs/docker_image_template/build_abfs_image.sh
                '''
              }
            }
          }
        }
      }
    }
  }
}
