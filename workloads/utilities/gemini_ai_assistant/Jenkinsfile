// Description:
// Run gemini on provided artifacts.
//
// Pod scheduling/resources align with cvdPipeline diagnostics AI Review and
// workloads/common/agentic-ai/gemini/run_ai_review.sh consumers (explicit QoS; not BestEffort).
// Schedules on the dedicated utility node pool (workloadLabel:utility + workloadType=utility:NoSchedule),
// not the Android build pool. Idle sleep must exceed gemini_analysis timeout (2h below).

pipeline {

  // Parameters defined in groovy/job.groovy

  agent {
    kubernetes {
      // Align with cvdPipeline Diagnostics: child yaml wins over inherited Kubernetes cloud podTemplate (e.g. safe-to-evict).
      yamlMergeStrategy merge()
      yaml """\
        apiVersion: v1
        kind: Pod
        metadata:
          annotations:
            # "false" reduces voluntary eviction from cluster-autoscaler scale-down; node-pressure eviction can still occur.
            cluster-autoscaler.kubernetes.io/safe-to-evict: "false"
        spec:
          serviceAccountName: ${JENKINS_SERVICE_ACCOUNT}
          nodeSelector:
            workloadLabel: utility
          tolerations:
            - key: workloadType
              operator: Equal
              value: utility
              effect: NoSchedule
          containers:
          - name: builder
            image: ${CLOUD_REGION}-docker.pkg.dev/${CLOUD_PROJECT}/${UTILITIES_DOCKER_ARTIFACT_PATH_NAME}:latest
            imagePullPolicy: Always
            resources:
              requests:
                cpu: 16000m
                memory: 48Gi
              limits:
                cpu: 32000m
                memory: 96Gi
            command:
            - sleep
            args:
            - 4h
      """.stripIndent()
    }
  }

  stages {
    stage ('AI Review') {
      when {
        allOf {
          expression { env.GEMINI_ARTIFACTS_COMMAND }
          expression {
            return params.AI_REVIEW_RUNTIME == 'agy' || (params.GEMINI_PROMPT_FILE?.trim() ? true : false)
          }
        }
      }
      steps {
        script {
          currentBuild.description = "$BUILD_USER"
        }
        container(name: 'builder') {
          catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
            sh '''
              set +x
              export PIPELINE_REPO_ROOT="${WORKSPACE}"
              export AI_REVIEW_RUNTIME="${AI_REVIEW_RUNTIME:-agy}"
              export GEMINI_ANALYSIS_PATH="${WORKSPACE}"
              export GEMINI_SKIP_MOVE_ARTIFACTS="1"
              export GEMINI_AI_EXECUTION_TIMEOUT_MINUTES="${GEMINI_AI_EXECUTION_TIMEOUT_MINUTES:-60}"
              export GEMINI_PREVIEW_FEATURES="${GEMINI_PREVIEW_FEATURES}"
              [ "$GEMINI_LOCATION_GLOBAL" = "true" ] && export GOOGLE_CLOUD_LOCATION="global" || export GOOGLE_CLOUD_LOCATION="${CLOUD_REGION}"
              export GOOGLE_CLOUD_PROJECT="${CLOUD_PROJECT}"
              export GEMINI_MODEL="${GEMINI_MODEL:-}"
              export GEMINI_PROMPT_FILE="${GEMINI_PROMPT_FILE}"
              export GEMINI_PROMPT_FILE_2="${GEMINI_PROMPT_FILE_2:-}"
              export GEMINI_PROMPT_FILE_3="${GEMINI_PROMPT_FILE_3:-}"
              [ -n "${GEMINI_SKILLS_YAML:-}" ] && export GEMINI_SKILLS_YAML="${GEMINI_SKILLS_YAML}"
              export GEMINI_COMMAND_LINE="${GEMINI_COMMAND_LINE}"
              export AI_REVIEW_RUNTIME="${AI_REVIEW_RUNTIME:-agy}"

              # Unpack Cuttlefish logs and CTS test results after artifact retrieval (mirrors cvdPipeline / Argo staging)
              UNPACK_CVD_CMD='mkdir -p "${WORKSPACE}/test-results/cvd" 2>/dev/null || true; for z in "${WORKSPACE}"/test-results/cuttlefish*.zip "${WORKSPACE}"/cuttlefish*.zip; do if [ -f "$z" ]; then echo "[gemini_ai_assistant] Unpacking $z -> test-results/cvd/"; unzip -q -o "$z" -d "${WORKSPACE}/test-results/cvd" 2>/dev/null || true; fi; done'
              UNPACK_CTS_CMD='mkdir -p "${WORKSPACE}/test-results/cts" 2>/dev/null || true; for z in "${WORKSPACE}"/test-results/android-cts-results/*.zip "${WORKSPACE}"/android-cts-results/*.zip "${WORKSPACE}"/test-results/*.zip; do if [ -f "$z" ] && [[ "$(basename "$z")" != cuttlefish* ]]; then echo "[gemini_ai_assistant] Unpacking $z -> test-results/cts/"; unzip -q -o "$z" -d "${WORKSPACE}/test-results/cts" 2>/dev/null || true; for d in "${WORKSPACE}"/test-results/cts/*; do if [ -d "$d" ] && { [ -f "$d/test_result.xml" ] || [ -f "$d/invocation_summary.txt" ]; }; then echo "[gemini_ai_assistant] Hoisting CTS session artifacts from $d -> test-results/cts/"; find "$d" -mindepth 1 -maxdepth 1 -exec mv -f {} "${WORKSPACE}/test-results/cts/" \\; 2>/dev/null || true; rmdir "$d" 2>/dev/null || true; fi; done; fi; done; if [ -f "${WORKSPACE}/test-results/cts/invocation_summary.txt" ] && [ ! -f "${WORKSPACE}/test-results/invocation_summary.txt" ]; then cp -f "${WORKSPACE}/test-results/cts/invocation_summary.txt" "${WORKSPACE}/test-results/invocation_summary.txt"; fi'
              if [ -n "${GEMINI_ARTIFACTS_COMMAND:-}" ]; then
                export GEMINI_ARTIFACTS_COMMAND="${GEMINI_ARTIFACTS_COMMAND}; ${UNPACK_CVD_CMD}; ${UNPACK_CTS_CMD}"
              else
                export GEMINI_ARTIFACTS_COMMAND="${UNPACK_CVD_CMD}; ${UNPACK_CTS_CMD}"
              fi
              export GEMINI_POST_REVIEW_COMMAND='rm -rf "${WORKSPACE}/test-results/cvd" "${WORKSPACE}/test-results/cts" 2>/dev/null || true'

              bash "${WORKSPACE}/workloads/common/agentic-ai/gemini/run_ai_review.sh"
              '''
            }
            archiveArtifacts artifacts: 'gemini-assist/*', followSymlinks: false, onlyIfSuccessful: false, allowEmptyArchive: true
            archiveArtifacts artifacts: 'traces/*.json', followSymlinks: false, onlyIfSuccessful: false, allowEmptyArchive: true
            script {
              def runtime = (params.AI_REVIEW_RUNTIME ?: env.AI_REVIEW_RUNTIME ?: '').toString().trim()
              if (runtime != 'agy') {
                archiveArtifacts artifacts: 'headless_output*.json', followSymlinks: false, onlyIfSuccessful: false, allowEmptyArchive: false
              }
            }
            script {
              if (fileExists('gemini-client-error.zip')) {
                archiveArtifacts artifacts: 'gemini-client-error.zip', followSymlinks: false, onlyIfSuccessful: false, allowEmptyArchive: true
              }
            }
        }
      }
    }
  }
}
