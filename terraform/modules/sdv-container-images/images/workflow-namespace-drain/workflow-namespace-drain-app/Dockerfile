# Build the Workflow Namespace Drain controller binary.
ARG GO_VERSION
FROM --platform=linux/amd64 golang:${GO_VERSION}-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /workflow-namespace-drain .

FROM --platform=linux/amd64 gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /workflow-namespace-drain /workflow-namespace-drain
USER nonroot:nonroot
ENTRYPOINT ["/workflow-namespace-drain"]